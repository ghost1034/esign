# Local development only. Copy to .env; never commit real credentials.
ENVIRONMENT=local
DATABASE_URL=postgresql://esign:esign@127.0.0.1:55432/esign_dev
APP_BASE_URL=http://localhost:3100
PUBLIC_API_BASE_URL=http://127.0.0.1:8100
LOCAL_API_BASE_URL=http://127.0.0.1:8100
STORAGE_BACKEND=local
TASK_BACKEND=local
LOCAL_AUTH_BYPASS=true
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_LOCAL_AUTH_BYPASS=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=esign <noreply@localhost>
ESIGN_WEBHOOK_DISPATCH_ENABLED=false
ESIGN_AI_FIELD_PLACEMENT_MODEL=gemini-2.5-flash
ESIGN_AI_FIELD_PLACEMENT_LOCATION=global
# AI placement requires credentials for your independent development GCP project.
# GOOGLE_CLOUD_PROJECT_ID=
# To use real Firebase: set both bypasses false and populate these values.
# FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
